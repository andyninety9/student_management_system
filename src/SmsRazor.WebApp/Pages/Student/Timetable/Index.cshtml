@page
@model SmsRazor.WebApp.Pages.Student.Timetable.IndexModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "My Schedule";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">My Schedule</h2>
        <p class="text-muted small mb-0 mt-1">View your registered classes for the active term.</p>
    </div>
</div>

<!-- Term Selection Form -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-4">
        <form method="get" class="row gx-3 gy-2 align-items-center">
            <div class="col-sm-4">
                <label class="visually-hidden" for="SelectedTermId">Term</label>
                <select class="form-select border-primary" asp-for="SelectedTermId" asp-items="Model.TermsList" onchange="this.form.submit()">
                    <option value="">-- Select Active Term --</option>
                </select>
            </div>
            <div class="col-auto">
                <noscript>
                    <button type="submit" class="btn btn-primary">View</button>
                </noscript>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedTermId != Guid.Empty && !string.IsNullOrEmpty(Model.StudentCode))
{
    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4 flex-grow-1 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold mb-0">My Schedule</h5>
                    <p class="text-muted small mt-1 mb-0">Visual preview of your registered classes</p>
                </div>
                <div class="card-body p-4">
                    <div id="studentTimetable" style="min-height: 600px;"></div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <!-- FullCalendar -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    
    <script>
        const currentTermId = '@Model.SelectedTermId';
        const currentStudentCode = '@Model.StudentCode';
        const termStartDate = '@Model.TermStartDateIso';

        document.addEventListener('DOMContentLoaded', function () {
            if (currentTermId && currentTermId !== '00000000-0000-0000-0000-000000000000') {
                initCalendar();
            }
        });

        function initCalendar() {
            var calendarEl = document.getElementById('studentTimetable');
            if(!calendarEl) return;
            
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                initialDate: termStartDate ? termStartDate : undefined,
                headerToolbar: {
                    left: '',
                    center: 'title',
                    right: ''
                },
                slotMinTime: '07:00:00',
                slotMaxTime: '23:00:00',
                allDaySlot: false,
                hiddenDays: [0], // Hide sunday if needed
                dayHeaderFormat: { weekday: 'long' },
                events: `/Student/Timetable?handler=StudentTimetable&studentCode=${currentStudentCode}&termId=${currentTermId}`,
                eventContent: function(arg) {
                    return {
                        html: `<div class="p-1 fw-bold text-wrap text-truncate" style="font-size: 0.8rem; line-height: 1.2;">${arg.event.title}</div>`
                    };
                },
                height: 'auto'
            });
            calendar.render();
        }
    </script>
}
