@page
@model SmsRazor.WebApp.Pages.Student.Registration.IndexModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Course Registration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Course Registration</h2>
        <p class="text-muted small mb-0 mt-1">Select your term, view syllabus courses, and register for sections avoiding scheduling conflicts.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var alertClass = Model.StatusMessage.StartsWith("Error") ? "alert-danger" : "alert-success";
    <div class="alert @alertClass alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@Html.AntiForgeryToken()

<!-- Term Selection Form -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-4">
        <form method="get" class="row gx-3 gy-2 align-items-center">
            <div class="col-sm-3">
                <label class="visually-hidden" for="SelectedTermId">Term</label>
                <select class="form-select border-primary" asp-for="SelectedTermId" asp-items="Model.TermsList" onchange="this.form.submit()">
                    <option value="">-- Select Active Term --</option>
                </select>
            </div>
            <div class="col-auto">
                <noscript>
                    <button type="submit" class="btn btn-primary">Filter</button>
                </noscript>
                <div class="form-text mt-2 text-muted">Select a term to view available sections and your schedule.</div>
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedTermId != Guid.Empty && !string.IsNullOrEmpty(Model.StudentCode))
{
    <div class="row g-4">
        <!-- Syllabus Courses List -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold mb-0">Your Syllabus Courses</h5>
                    <p class="text-muted small mt-1">Click a course to see available sections.</p>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" id="courseList">
                        @if(!Model.SyllabusCourses.Any())
                        {
                            <div class="text-center p-4">
                                <i class="fa-solid fa-book-open-reader fs-1 text-muted opacity-25 mb-3"></i>
                                <p class="text-muted mb-0">No courses mapped to your syllabus yet.</p>
                            </div>
                        }
                        else
                        {
                            foreach (var course in Model.SyllabusCourses)
                            {
                                var isEnrolled = Model.CurrentEnrollments.Any(e => e.CourseId == course.CourseId);
                                <button type="button" class="list-group-item list-group-item-action p-4 border-bottom course-item @(isEnrolled ? "bg-light text-muted" : (!course.HasAvailableSections ? "bg-light bg-opacity-50" : ""))" 
                                        data-course-id="@course.CourseId"
                                        data-course-name="@course.CourseNameEng"
                                        onclick="loadSections(this, '@course.CourseId')">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1 fw-bold @(isEnrolled ? "text-muted" : "text-dark")">@course.CourseNameEng</h6>
                                            <small class="d-block mb-2 @(!course.HasAvailableSections && !isEnrolled ? "text-muted" : "")">@course.CourseNameVI</small>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2">@course.CreditNumber Credits</span>
                                        </div>
                                        @if(isEnrolled)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="fa-solid fa-check me-1"></i> Enrolled</span>
                                        }
                                        else if (!course.HasAvailableSections)
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2 opacity-75"><i class="fa-solid fa-ban me-1"></i> No Classes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary rounded-pill px-3 py-2"><i class="fa-solid fa-cart-plus me-1"></i> Select</span>
                                        }
                                    </div>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Sections & Timetable -->
        <div class="col-xl-8 col-lg-7 d-flex flex-column gap-4">
            
            <!-- Available Sections Panel (Hidden by default, shown via JS) -->
            <div class="card shadow-sm border-0 rounded-4" id="sectionsPanel" style="display: none;">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-primary" id="selectedCourseTitle">Select a Course</h5>
                        <p class="text-muted small mt-1 mb-0">Available sections for this term</p>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" onclick="closeSectionsPanel()"></button>
                </div>
                <div class="card-body p-4">
                    <div id="sectionsLoader" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <div id="sectionsContainer" class="row g-3">
                        <!-- Sections injected here via JS -->
                    </div>
                </div>
            </div>

            <!-- Current Schedule View -->
            <div class="card shadow-sm border-0 rounded-4 flex-grow-1">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold mb-0">My Schedule</h5>
                    <p class="text-muted small mt-1 mb-0">Visual preview of your registered classes</p>
                </div>
                <div class="card-body p-4">
                    <div id="studentTimetable" style="min-height: 400px;"></div>
                </div>
            </div>

            <!-- Current Enrollments List -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h5 class="fw-bold mb-0">Registered Classes (@Model.CurrentEnrollments.Count() / 5)</h5>
                </div>
                <div class="card-body p-4">
                    @if (!Model.CurrentEnrollments.Any())
                    {
                        <div class="text-center py-4">
                            <p class="text-muted mb-0">You have no registered classes for this term.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0 rounded-start">Section</th>
                                        <th class="border-0">Course</th>
                                        <th class="border-0 text-center">Credits</th>
                                        <th class="border-0">Teacher</th>
                                        <th class="border-0 text-end rounded-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in Model.CurrentEnrollments)
                                    {
                                        <tr>
                                            <td class="fw-medium">@e.SectionCode</td>
                                            <td>
                                                <div class="text-dark fw-medium">@e.CourseName</div>
                                            </td>
                                            <td class="text-center">@e.Credits</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                                        <i class="fa-solid fa-chalkboard-user small"></i>
                                                    </div>
                                                    <span>@e.TeacherName</span>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <button type="button" onclick="dropClass('@e.SectionId')" class="btn btn-sm btn-outline-danger px-3 rounded-pill">
                                                    <i class="fa-solid fa-xmark me-1"></i> Drop
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
}

@section Scripts {
    <!-- FullCalendar -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    
    <script>
        // Store selected term and student info globally for JS
        const currentTermId = '@Model.SelectedTermId';
        const currentStudentCode = '@Model.StudentCode';
        
        let calendar;

        document.addEventListener('DOMContentLoaded', function () {
            if (currentTermId && currentTermId !== '00000000-0000-0000-0000-000000000000') {
                initCalendar();
            }
        });

        function initCalendar() {
            var calendarEl = document.getElementById('studentTimetable');
            if(!calendarEl) return;
            
            calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                headerToolbar: {
                    left: '',
                    center: '',
                    right: ''
                },
                slotMinTime: '07:00:00',
                slotMaxTime: '23:00:00',
                allDaySlot: false,
                hiddenDays: [0], // Hide sunday if needed, but keeping for now
                dayHeaderFormat: { weekday: 'long' },
                events: `/Student/Registration?handler=StudentTimetable&studentCode=${currentStudentCode}&termId=${currentTermId}`,
                eventContent: function(arg) {
                    return {
                        html: `<div class="p-1 fw-bold text-wrap text-truncate" style="font-size: 0.8rem; line-height: 1.2;">${arg.event.title}</div>`
                    };
                },
                height: 'auto'
            });
            calendar.render();
        }

        // Handle clicking a course in the left list
        function loadSections(btnElement, courseId) {
            // Update active state
            document.querySelectorAll('.course-item').forEach(el => el.classList.remove('active', 'border-primary', 'shadow-sm', 'bg-primary', 'bg-opacity-10'));
            if(btnElement) {
                btnElement.classList.add('active', 'border-primary', 'shadow-sm', 'bg-primary', 'bg-opacity-10');
            }
            
            const courseName = btnElement.getAttribute('data-course-name');
            document.getElementById('selectedCourseTitle').innerText = 'Sections for ' + courseName;
            
            // Show panel and loader
            const panel = document.getElementById('sectionsPanel');
            const loader = document.getElementById('sectionsLoader');
            const container = document.getElementById('sectionsContainer');
            
            panel.style.display = 'block';
            loader.classList.remove('d-none');
            container.innerHTML = '';
            
            // Fetch Sections
            fetch(`/Student/Registration?handler=AvailableSections&courseId=${courseId}&termId=${currentTermId}`)
                .then(response => response.json())
                .then(data => {
                    loader.classList.add('d-none');
                    if(data.length === 0) {
                        container.innerHTML = `<div class="col-12"><div class="alert alert-warning mb-0 border-0 bg-warning bg-opacity-10 text-warning d-flex align-items-center"><i class="fa-solid fa-triangle-exclamation me-3 fs-4"></i> No sections available for this course in the selected term.</div></div>`;
                        return;
                    }

                    // Render Cards
                    let html = '';
                    const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                    const tokenHtml = tokenElement ? tokenElement.outerHTML : '';
                    
                    data.forEach(s => {
                        const isFull = s.capacity <= 0; // Note: You'd ideally return calculated remaining capacity from BLL
                        const badgeHtml = isFull 
                            ? `<span class="badge bg-danger">Full</span>` 
                            : `<span class="badge bg-success">Available</span>`;
                            
                        html += `
                            <div class="col-md-6 mb-3">
                                <div class="card h-100 border-1 shadow-sm rounded-3 hover-shadow transition-all">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-chalkboard text-primary me-2"></i>${s.sectionCode}</h6>
                                            ${badgeHtml}
                                        </div>
                                        <div class="small text-muted mb-3">
                                            <div class="mb-1"><i class="fa-solid fa-user-tie me-2 text-primary opacity-75"></i> ${s.teacherName}</div>
                                            <div><i class="fa-regular fa-clock me-2 text-primary opacity-75"></i> ${s.scheduleTime || 'TBA'}</div>
                                        </div>
                                        
                                        <div class="mt-auto">
                                            <!-- Antiforgery Token is required, we need to inject it or serialize it. -> Workaround: ASP.NET Core Form Tag Helper handles it if we use standard forms. To do it dynamically in plain HTML we extract it from the page -->
                                            ${tokenHtml}
                                            <button type="button" onclick="registerClass('${s.sectionId}')" class="btn btn-primary btn-sm w-100 rounded-pill fw-medium shadow-sm" ${isFull ? 'disabled' : ''}>
                                                <i class="fa-solid fa-plus me-1"></i> Register Class
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                    
                    // Smooth scroll to sections
                    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                })
                .catch(err => {
                    loader.classList.add('d-none');
                    container.innerHTML = `<div class="alert alert-danger">Error loading sections.</div>`;
                    console.error('Error fetching sections:', err);
                });
        }
        
        function registerClass(sectionId) {
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!tokenElement) {
                Swal.fire('Error', 'Security token missing. Please refresh the page.', 'error');
                return;
            }

            Swal.fire({
                title: 'Processing...',
                text: 'Registering your class...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // ASP.NET Core Razor Pages uses urlencoded form data naturally for posts
            const formData = new URLSearchParams();
            formData.append('sectionId', sectionId);
            formData.append('SelectedTermId', currentTermId);
            formData.append('__RequestVerificationToken', tokenElement.value);

            fetch(`/Student/Registration?handler=Register`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: data.message,
                        confirmButtonColor: '#0d6efd'
                    }).then(() => {
                        window.location.reload(); // Simple refresh to apply all state changes (Available sections + enrolled list + calendar)
                    });
                } else {
                    Swal.fire('Failed', data.message, 'error');
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire('Error', 'An unexpected network error occurred.', 'error');
            });
        }

        function dropClass(sectionId) {
            Swal.fire({
                title: 'Are you sure?',
                text: 'You are about to drop this class. You may lose your seat.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, drop it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                    
                    Swal.fire({
                        title: 'Dropping class...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    // We changed OnPostDropAsync to accept [FromBody] JSON for demonstration
                    fetch(`/Student/Registration?handler=Drop`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenElement ? tokenElement.value : ''
                        },
                        body: JSON.stringify({ sectionId: sectionId })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Dropped',
                                text: data.message,
                                confirmButtonColor: '#0d6efd'
                            }).then(() => window.location.reload());
                        } else {
                            Swal.fire('Failed', data.message, 'error');
                        }
                    })
                    .catch(err => Swal.fire('Error', 'An unexpected network error occurred.', 'error'));
                }
            });
        }
        
        function closeSectionsPanel() {
            document.getElementById('sectionsPanel').style.display = 'none';
            document.querySelectorAll('.course-item').forEach(el => el.classList.remove('active', 'border-primary', 'shadow-sm', 'bg-primary', 'bg-opacity-10'));
        }
    </script>
}
