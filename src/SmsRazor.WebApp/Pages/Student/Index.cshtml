@page
@model SmsRazor.WebApp.Pages.Student.IndexModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "My Hub";
}

<div class="row align-items-center mb-5">
    <div class="col-md-8">
        <h1 class="fw-bold tracking-tight mb-2">Welcome back, Student! 👋</h1>
        <p class="text-muted fs-5 mb-0">Here's what's happening with your studies today.</p>
    </div>
    <div class="col-md-4 text-md-end mt-4 mt-md-0">
        <div class="d-inline-flex align-items-center bg-white border rounded-pill px-4 py-2 shadow-sm">
            <i class="fa-regular fa-calendar text-primary me-2"></i>
            <span class="fw-medium">Fall Semester 2026</span>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-8">
        <div class="student-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">My Enrolled Courses</h4>
                <a href="#" class="text-decoration-none fw-medium">View All <i class="fa-solid fa-arrow-right ms-1"></i></a>
            </div>
            
            <div class="list-group list-group-flush gap-2">
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border rounded-3 p-3 mb-2 shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                            <i class="fa-solid fa-code fa-lg"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Web Development Fundamentals</h6>
                            <small class="text-muted">CS-302 &bull; Prof. John Doe</small>
                        </div>
                    </div>
                    <div class="text-end d-none d-sm-block">
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Ongoing</span>
                    </div>
                </a>
                
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border rounded-3 p-3 mb-2 shadow-sm">
                    <div class="d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 text-info rounded-3 p-3 me-3">
                            <i class="fa-solid fa-database fa-lg"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Database Systems</h6>
                            <small class="text-muted">CS-204 &bull; Dr. Alice Smith</small>
                        </div>
                    </div>
                    <div class="text-end d-none d-sm-block">
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">Ongoing</span>
                    </div>
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="student-card h-100 p-4">
            <h4 class="fw-bold mb-4">Upcoming Deadlines</h4>
            
            <div class="position-relative">
                <!-- Timeline line -->
                <div class="position-absolute start-0 top-0 bottom-0 ms-2 border-start border-2 border-primary border-opacity-25" style="transform: translateX(4px);"></div>
                
                <div class="position-relative mb-4 ps-4">
                    <div class="position-absolute start-0 top-0 mt-1 bg-white border border-2 border-danger rounded-circle" style="width: 12px; height: 12px; transform: translateX(0px);"></div>
                    <p class="text-danger fw-bold mb-1 small">Today, 11:59 PM</p>
                    <h6 class="fw-bold mb-1">React Assignment 2</h6>
                    <p class="text-muted small mb-0">Web Development</p>
                </div>
                
                <div class="position-relative mb-4 ps-4">
                    <div class="position-absolute start-0 top-0 mt-1 bg-white border border-2 border-warning rounded-circle" style="width: 12px; height: 12px; transform: translateX(0px);"></div>
                    <p class="text-warning text-dark fw-bold mb-1 small">Tomorrow, 08:00 AM</p>
                    <h6 class="fw-bold mb-1">Midterm Exam prep</h6>
                    <p class="text-muted small mb-0">Database Systems</p>
                </div>
                
                <div class="position-relative ps-4">
                    <div class="position-absolute start-0 top-0 mt-1 bg-white border border-2 border-primary rounded-circle" style="width: 12px; height: 12px; transform: translateX(0px);"></div>
                    <p class="text-primary fw-bold mb-1 small">Oct 25, 2026</p>
                    <h6 class="fw-bold mb-1">Project Milestone 1</h6>
                    <p class="text-muted small mb-0">Web Development</p>
                </div>
            </div>
        </div>
    </div>
</div>
