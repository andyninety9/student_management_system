<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="icon" type="image/jpeg" href="~/images/logo-FPT-1x1.jpg" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student/student-layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg student-navbar sticky-top border-bottom">
        <div class="container">
            <a class="navbar-brand student-brand" href="/Student/Index">
                <img src="~/images/logo-FPT-1x1.jpg" alt="Logo" width="32" height="32" class="d-inline-block align-text-top rounded-circle me-2 border">
                Student <span class="fw-light ms-1">Portal</span>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-toggle="target="#studentNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="studentNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4 gap-3 align-items-center">
                    <li class="nav-item">
                        <a class="student-nav-link @(Context.Request.Path.Value == "/Student/Index" ? "active" : "")" href="/Student/Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link text-center @(Context.Request.Path.Value?.StartsWith("/Student/Registration") == true ? "active" : "")" href="/Student/Registration">Registration</a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link" href="#">Grades</a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link @(Context.Request.Path.Value?.StartsWith("/Student/Attendance") == true ? "active" : "")" href="/Student/Attendance">Attendance</a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link @(Context.Request.Path.Value?.StartsWith("/Student/Timetable") == true ? "active" : "")" href="/Student/Timetable">Schedule</a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link text-center @(Context.Request.Path.Value?.StartsWith("/Student/Tuition") == true ? "active" : "")" href="/Student/Tuition">Tuition</a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link text-primary text-center d-flex flex-column align-items-center @(Context.Request.Path.Value?.StartsWith("/Chat") == true ? "active" : "")" href="/Chat">
                            <i class="fa-regular fa-message mb-1"></i> Messages
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link text-success text-center d-flex flex-column align-items-center @(Context.Request.Path.Value?.StartsWith("/Student/AIAssistant") == true ? "active" : "")" href="/Student/AIAssistant">
                            <i class="fa-solid fa-robot mb-1"></i> AI Assistant
                        </a>
                    </li>
                </ul>
                
                @{
                    var studentName = User.Identity?.Name ?? "Student Name";
                    var initials = "ST";
                    if (!string.IsNullOrEmpty(studentName))
                    {
                        var parts = studentName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        if (parts.Length >= 2)
                        {
                            initials = $"{parts[0][0]}{parts[^1][0]}".ToUpper();
                        }
                        else if (parts.Length == 1)
                        {
                            initials = parts[0][0].ToString().ToUpper();
                        }
                    }
                }
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" id="dropdownUser" data-bs-toggle="dropdown">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px; font-weight: 600;">
                                @initials
                            </div>
                            <span class="fw-medium">@studentName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="dropdownUser">
                            <li><a class="dropdown-item py-2" href="/Student/Profile"><i class="fa-regular fa-user me-2 opacity-50"></i> Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a href="/Auth/Logout" class="dropdown-item text-danger py-2">
                                    <i class="fa-solid fa-arrow-right-from-bracket me-2 opacity-50"></i> Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="student-main container">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-4 mt-auto">
        <div class="container text-center text-muted small">
            &copy; 2026 - Student Management System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
