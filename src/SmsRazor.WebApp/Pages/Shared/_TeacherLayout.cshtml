<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Teacher Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="icon" type="image/jpeg" href="~/images/logo-FPT-1x1.jpg" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student/student-layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg student-navbar sticky-top border-bottom">
        <div class="container">
            <a class="navbar-brand student-brand" href="/Teacher/Index">
                <img src="~/images/logo-FPT-1x1.jpg" alt="Logo" width="32" height="32" class="d-inline-block align-text-top rounded-circle me-2 border">
                Teacher <span class="fw-light ms-1">Portal</span>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#teacherNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="teacherNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4 gap-2">
                    <li class="nav-item">
                        <a class="student-nav-link @(Context.Request.Path.Value == "/Teacher/Index" ? "active" : "")" href="/Teacher/Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link @(Context.Request.Path.Value?.StartsWith("/Teacher/Classes") == true ? "active" : "")" href="#">My Classes</a>
                    </li>
                    <li class="nav-item">
                        <a class="student-nav-link text-primary @(Context.Request.Path.Value?.StartsWith("/Chat") == true ? "active" : "")" href="/Chat">
                            <i class="fa-regular fa-message me-1"></i> Messages
                        </a>
                    </li>
                </ul>
                
                @{
                    var teacherName = User.Identity?.Name ?? "Teacher Name";
                    var initials = "TC";
                    if (!string.IsNullOrEmpty(teacherName))
                    {
                        var parts = teacherName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        if (parts.Length >= 2)
                        {
                            initials = $"{parts[0][0]}{parts[^1][0]}".ToUpper();
                        }
                        else if (parts.Length == 1)
                        {
                            initials = parts[0][0].ToString().ToUpper();
                        }
                    }
                }
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" id="dropdownUser" data-bs-toggle="dropdown">
                            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px; font-weight: 600;">
                                @initials
                            </div>
                            <span class="fw-medium">@teacherName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="dropdownUser">
                            <li><a class="dropdown-item py-2" href="#"><i class="fa-regular fa-user me-2 opacity-50"></i> Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a href="/Auth/Logout" class="dropdown-item text-danger py-2">
                                    <i class="fa-solid fa-arrow-right-from-bracket me-2 opacity-50"></i> Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="student-main container mt-4">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-4 mt-auto">
        <div class="container text-center text-muted small">
            &copy; 2026 - Student Management System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
