@page "{id}"
@model SmsRazor.WebApp.Pages.Admin.Teachers.DeleteModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Teacher";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-danger fw-bold">Delete Teacher</h2>
        <p class="text-muted small mb-0 mt-1">Permanently remove this faculty member</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm px-4 rounded-pill shadow-sm">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-danger shadow-sm rounded-4 overflow-hidden max-w-2xl mx-auto mt-4">
    <div class="card-body p-4 p-md-5 text-center">
        <div class="mb-4">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
            </div>
        </div>
        
        <h4 class="fw-bold mb-3">Are you absolutely sure?</h4>
        <p class="text-muted mb-4">
            You are about to delete the teacher <strong>@Model.Teacher.Fullname</strong> (@Model.Teacher.TeacherCode). 
            This action cannot be undone and will permanently remove their account from the system.
        </p>

        <div class="bg-light rounded-3 p-3 mb-4 text-start">
            <div class="row g-2 small">
                <div class="col-sm-4 text-muted fw-medium">Department:</div>
                <div class="col-sm-8 fw-bold">@Model.Teacher.DepartmentName</div>
                
                <div class="col-sm-4 text-muted fw-medium">Email:</div>
                <div class="col-sm-8">@Model.Teacher.Email</div>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Teacher.TeacherCode" />
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-page="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                    <i class="fa-solid fa-trash me-2"></i> Yes, Delete Teacher
                </button>
            </div>
        </form>
    </div>
</div>
