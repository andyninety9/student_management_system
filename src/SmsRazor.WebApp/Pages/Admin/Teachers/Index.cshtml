@page
@model SmsRazor.WebApp.Pages.Admin.Teachers.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Teachers";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-teachers.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4">
    <div>
        <h2 class="mb-1 fw-bold tracking-tight text-dark">Teachers Directory</h2>
        <p class="text-muted mb-0">Manage faculty members and assignments.</p>
    </div>
    <button class="btn btn-dark px-4 py-2 fw-semibold rounded-3">
        <i class="fa-solid fa-user-plus me-2"></i> Add Teacher
    </button>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card teacher-card h-100 bg-white shadow-none rounded-3 p-4">
            <div class="d-flex align-items-center mb-3">
                <div class="avatar-circle me-3 border">JD</div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark">Dr. John Doe</h5>
                    <p class="text-muted small mb-0">Computer Science</p>
                </div>
            </div>
            <div class="mb-3 small text-muted">
                <div class="mb-1"><i class="fa-regular fa-envelope me-2"></i> john.doe@university.edu</div>
                <div><i class="fa-solid fa-phone me-2"></i> +1 234 567 890</div>
            </div>
            <div class="mt-auto pt-3 border-top d-flex justify-content-between">
                <button class="btn btn-sm btn-outline-dark rounded-pill px-3">Profile</button>
                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Remove</button>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card teacher-card h-100 bg-white shadow-none rounded-3 p-4">
            <div class="d-flex align-items-center mb-3">
                <div class="avatar-circle me-3 border">AS</div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark">Prof. Alice Smith</h5>
                    <p class="text-muted small mb-0">Mathematics</p>
                </div>
            </div>
            <div class="mb-3 small text-muted">
                <div class="mb-1"><i class="fa-regular fa-envelope me-2"></i> alice.smith@university.edu</div>
                <div><i class="fa-solid fa-phone me-2"></i> +1 987 654 321</div>
            </div>
            <div class="mt-auto pt-3 border-top d-flex justify-content-between">
                <button class="btn btn-sm btn-outline-dark rounded-pill px-3">Profile</button>
                <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Remove</button>
            </div>
        </div>
    </div>
</div>
