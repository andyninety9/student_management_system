@page
@model SmsRazor.WebApp.Pages.Admin.Terms.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Semester";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Create New Semester (Term)</h2>
        <p class="text-muted small mb-0 mt-1">Define an academic timeline for courses and classes</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm px-4 rounded-pill shadow-sm">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 max-w-2xl mx-auto overflow-hidden">
    <div class="card-body p-4 p-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3 bg-danger bg-opacity-10 rounded-3"></div>

            <h5 class="fw-bold mb-4 border-bottom pb-2">Term Details</h5>
            
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Term.Code" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="Term.Code" class="form-control rounded-3" placeholder="e.g. FA26, SP26" />
                    <span asp-validation-for="Term.Code" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Term.Name" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="Term.Name" class="form-control rounded-3" placeholder="e.g. Fall 2026" />
                    <span asp-validation-for="Term.Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Term.StartDate" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="Term.StartDate" class="form-control rounded-3" />
                    <span asp-validation-for="Term.StartDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Term.EndDate" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="Term.EndDate" class="form-control rounded-3" />
                    <span asp-validation-for="Term.EndDate" class="text-danger small"></span>
                </div>
                <div class="col-12 mt-4 d-flex align-items-center">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="Term.IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked>
                        <label class="form-check-label ms-2" for="isActiveSwitch">Set as Active Term</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-5 border-top pt-4">
                <a asp-page="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-dark rounded-pill px-4 shadow-sm">
                    <i class="fa-solid fa-save me-2"></i> Save Semester
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
