@page "{id:guid}"
@model SmsRazor.WebApp.Pages.Admin.Terms.DeleteModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Semester";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-danger fw-bold">Delete Semester</h2>
        <p class="text-muted small mb-0 mt-1">Permanently remove this academic term</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm px-4 rounded-pill shadow-sm">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

@if (Model.Term != null)
{
    <div class="card border-danger shadow-sm rounded-4 overflow-hidden max-w-2xl mx-auto mt-4">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="mb-4">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
                </div>
            </div>
            
            <h4 class="fw-bold mb-3">Are you absolutely sure?</h4>
            <p class="text-muted mb-4">
                You are about to delete the semester <strong>@Model.Term.Name</strong> (@Model.Term.Code). 
                This action cannot be undone. <br/>
                <em>Note: If this term has existing classes or timetables associated with it, deletion will fail.</em>
            </p>

            <form method="post">
                <input type="hidden" asp-for="Term.TermId" />
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a asp-page="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="fa-solid fa-trash me-2"></i> Yes, Delete Semester
                    </button>
                </div>
            </form>
        </div>
    </div>
}
