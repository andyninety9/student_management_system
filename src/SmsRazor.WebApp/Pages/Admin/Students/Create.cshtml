@page
@model SmsRazor.WebApp.Pages.Admin.Students.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Student";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Create Student</h2>
        <p class="text-muted small mb-0 mt-1">Register a new student account</p>
    </div>
    <a asp-page="Index" class="btn btn-light border btn-sm px-3 rounded-pill d-flex align-items-center">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="max-width: 900px;">
    <div class="card-body p-4 p-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3 bg-danger bg-opacity-10 rounded-3"></div>

            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">1. Account Information</h5>
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label asp-for="Student.Fullname" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="Student.Fullname" class="form-control rounded-3" placeholder="e.g. John Doe" />
                    <span asp-validation-for="Student.Fullname" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Student.Email" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="Student.Email" class="form-control rounded-3" placeholder="email@fpt.edu.vn" />
                    <span asp-validation-for="Student.Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Student.Password" class="form-label fw-medium text-dark">Initial Password</label> <span class="text-danger">*</span>
                    <input asp-for="Student.Password" class="form-control rounded-3" value="123456" />
                    <div class="form-text small">Default is 123456. Student can change it later.</div>
                    <span asp-validation-for="Student.Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Student.Dob" class="form-label fw-medium text-dark"></label>
                    <input asp-for="Student.Dob" class="form-control rounded-3" />
                    <span asp-validation-for="Student.Dob" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Student.Gender" class="form-label fw-medium text-dark"></label>
                    <select asp-for="Student.Gender" class="form-select rounded-3">
                        <option value="">-- Select --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="Student.Phone" class="form-label fw-medium text-dark"></label>
                    <input asp-for="Student.Phone" class="form-control rounded-3" />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch fs-5 pb-1">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="Student.IsActive" checked>
                        <label class="form-check-label fs-6 mt-1 ms-2">Account Active</label>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">2. Academic Information</h5>
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Student.StudentCode" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="Student.StudentCode" class="form-control rounded-3 fw-bold text-primary" placeholder="e.g. SE123456" />
                    <span asp-validation-for="Student.StudentCode" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Student.IntakeId" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <select asp-for="Student.IntakeId" class="form-select rounded-3" asp-items="Model.Intakes">
                        <option value="">-- Select Intake --</option>
                    </select>
                    <span asp-validation-for="Student.IntakeId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Student.DepartmentId" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <select asp-for="Student.DepartmentId" class="form-select rounded-3" asp-items="Model.Departments" id="depSelect">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="Student.DepartmentId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Student.SyllabusId" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <select asp-for="Student.SyllabusId" class="form-select rounded-3" asp-items="Model.Syllabuses" id="sylSelect">
                        <option value="">-- Select Syllabus --</option>
                    </select>
                    <span asp-validation-for="Student.SyllabusId" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Student.StudentStatusId" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <select asp-for="Student.StudentStatusId" class="form-select rounded-3" asp-items="Model.Statuses">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="Student.StudentStatusId" class="text-danger small"></span>
                </div>

            </div>

            <hr class="my-5 text-muted border-opacity-25" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="Index" class="btn btn-light border px-4 rounded-pill">Cancel</a>
                <button type="submit" class="btn btn-dark px-4 rounded-pill">Create Student</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Simple client-side dependency: In a real app we'd use AJAX to load Syllabuses based on Department
        // Setup initial text
        $('#sylSelect').select2({ theme: 'bootstrap-5' });
        $('#depSelect').select2({ theme: 'bootstrap-5' });
    </script>
}
