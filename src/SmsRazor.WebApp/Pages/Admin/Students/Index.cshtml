@page
@model SmsRazor.WebApp.Pages.Admin.Students.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Students";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-students.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4">
    <div>
        <h2 class="mb-1 fw-bold tracking-tight text-dark">Student Directory</h2>
        <p class="text-muted mb-0">Manage enrolled students across all departments.</p>
    </div>
    <div class="d-flex gap-3">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0 border"><i class="fa-solid fa-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0 border shadow-none" placeholder="Search students...">
        </div>
        <button class="btn btn-dark px-4 fw-semibold text-nowrap rounded-3">
            <i class="fa-solid fa-user-plus me-2"></i> Enroll Student
        </button>
    </div>
</div>

<div class="card border-0 shadow-none bg-white rounded-3 border">
    <div class="card-body p-0 table-responsive">
        <table class="table student-table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Student Name</th>
                    <th>ID Number</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="ps-4 text-dark fw-bold">Michael Johnson</td>
                    <td class="text-muted">STU-2025-001</td>
                    <td>Computer Science</td>
                    <td><span class="badge bg-dark rounded-pill fw-normal px-3 py-2">Enrolled</span></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-sm btn-outline-dark rounded-pill px-3">View</button>
                    </td>
                </tr>
                <tr>
                    <td class="ps-4 text-dark fw-bold">Sarah Williams</td>
                    <td class="text-muted">STU-2025-002</td>
                    <td>Physics</td>
                    <td><span class="badge border border-dark text-dark rounded-pill fw-normal px-3 py-2">On Leave</span></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-sm btn-outline-dark rounded-pill px-3">View</button>
                    </td>
                </tr>
                <tr>
                    <td class="ps-4 text-dark fw-bold">David Chen</td>
                    <td class="text-muted">STU-2025-003</td>
                    <td>Mathematics</td>
                    <td><span class="badge bg-dark rounded-pill fw-normal px-3 py-2">Enrolled</span></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-sm btn-outline-dark rounded-pill px-3">View</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
