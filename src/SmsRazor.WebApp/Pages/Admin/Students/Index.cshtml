@page
@model SmsRazor.WebApp.Pages.Admin.Students.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Students Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Students</h2>
        <p class="text-muted small mb-0 mt-1">Manage all registered students and their accounts</p>
    </div>
    <a asp-page="Create" class="btn btn-dark btn-sm px-4 rounded-pill d-flex align-items-center shadow-sm">
        <i class="fa-solid fa-plus me-2"></i> Add New Student
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var alertClass = Model.StatusMessage.StartsWith("Error") ? "alert-danger" : "alert-success";
    <div class="alert @alertClass alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="studentsTable">
                <thead class="bg-light text-muted small fw-semibold text-uppercase">
                    <tr>
                        <th class="px-4 py-3 border-0">Code</th>
                        <th class="py-3 border-0">Full Name</th>
                        <th class="py-3 border-0">Email</th>
                        <th class="py-3 border-0">Department / Intake</th>
                        <th class="py-3 border-0">Status</th>
                        <th class="px-4 py-3 border-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model.Students != null && Model.Students.Any())
                    {
                        foreach (var st in Model.Students)
                        {
                            <tr>
                                <td class="px-4 py-3 text-dark fw-medium">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        @st.StudentCode
                                    </div>
                                </td>
                                <td class="py-3">@st.Fullname</td>
                                <td class="py-3">@st.Email</td>
                                <td class="py-3">
                                    <div class="fw-medium text-dark">@st.DepartmentName</div>
                                    <div class="text-muted small">@st.IntakeName</div>
                                </td>
                                <td class="py-3">
                                    @if(st.StatusName == "Studying")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium border border-success border-opacity-25">@st.StatusName</span>
                                    }
                                    else if(st.StatusName == "Dropped Out" || st.StatusName == "Suspended")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-medium border border-danger border-opacity-25">@st.StatusName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-medium border border-secondary border-opacity-25">@st.StatusName</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="#" class="btn btn-sm btn-outline-warning rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Reset Password" data-bs-toggle="modal" data-bs-target="#resetPasswordModal" onclick="prepareReset('@st.StudentCode', '@st.Fullname')">
                                            <i class="fa-solid fa-key"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@st.StudentCode" class="btn btn-sm btn-light border rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Edit">
                                            <i class="fa-solid fa-pen text-muted"></i>
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@st.StudentCode" class="btn btn-sm btn-light border rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Delete">
                                            <i class="fa-solid fa-trash text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="mb-3"><i class="fa-solid fa-user-graduate fs-1 text-light"></i></div>
                                <div>No students found.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="ResetPassword">
                <div class="modal-body">
                    <p class="text-muted small mb-4">Set a new password for <strong id="resetTargetName" class="text-dark"></strong>.</p>
                    <input type="hidden" name="studentCode" id="resetStudentCode" />
                    <div class="mb-3">
                        <label class="form-label fw-medium text-dark">New Password <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" id="newPasswordInput" name="newPassword" class="form-control bg-light" required minlength="6" readonly />
                            <button class="btn btn-outline-secondary" type="button" id="generateBtn" onclick="generateRandomPassword()" title="Generate New Password"><i class="fa-solid fa-arrows-rotate"></i></button>
                            <button class="btn btn-outline-secondary" type="button" id="copyBtn" onclick="copyPassword()" title="Copy to clipboard"><i class="fa-regular fa-copy"></i></button>
                        </div>
                        <div class="form-text text-warning mt-2"><i class="fa-solid fa-triangle-exclamation"></i> Please copy the password before confirming.</div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4">Confirm Reset</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            if ($('#studentsTable tbody tr').length > 0 && !$('#studentsTable tbody tr td').hasClass('dataTables_empty') && $('#studentsTable tbody tr td').length > 1) {
                $('#studentsTable').DataTable({
                    "pageLength": 10,
                    "ordering": true,
                    "info": true,
                    "lengthChange": false,
                    "language": {
                        "search": "",
                        "searchPlaceholder": "Search students..."
                    },
                    "dom": "<'row mb-3'<'col-md-6'f><'col-md-6 text-end'>>" +
                           "<'row'<'col-sm-12'tr>>" +
                           "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
                });
                
                // Style the search box to match our theme
                $('.dataTables_filter input').addClass('form-control rounded-pill border-light shadow-sm px-3');
            }
        });

        function prepareReset(code, name) {
            document.getElementById('resetStudentCode').value = code;
            document.getElementById('resetTargetName').innerText = name;
            generateRandomPassword();
        }

        function generateRandomPassword() {
            const length = 10;
            const charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@@#$%^&*";
            let retVal = "";
            for (let i = 0, n = charset.length; i < length; ++i) {
                retVal += charset.charAt(Math.floor(Math.random() * n));
            }
            
            // Ensure at least 1 upper, 1 lower, 1 digit, 1 special character
            const uppers = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            const lowers = "abcdefghijklmnopqrstuvwxyz";
            const numbers = "0123456789";
            const specials = "!@@#$%^&*";
            
            retVal = retVal.substring(4) 
                   + uppers.charAt(Math.floor(Math.random() * uppers.length))
                   + lowers.charAt(Math.floor(Math.random() * lowers.length))
                   + numbers.charAt(Math.floor(Math.random() * numbers.length))
                   + specials.charAt(Math.floor(Math.random() * specials.length));
                   
            // Shuffle
            retVal = retVal.split('').sort(() => 0.5 - Math.random()).join('');

            document.getElementById('newPasswordInput').value = retVal;
            
            const copyBtn = document.getElementById('copyBtn');
            copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i>';
            copyBtn.classList.remove('btn-success');
            copyBtn.classList.add('btn-outline-secondary');
        }

        function copyPassword() {
            const passwordInput = document.getElementById('newPasswordInput');
            passwordInput.select();
            passwordInput.setSelectionRange(0, 99999);
            
            navigator.clipboard.writeText(passwordInput.value).then(() => {
                const copyBtn = document.getElementById('copyBtn');
                copyBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
                copyBtn.classList.remove('btn-outline-secondary');
                copyBtn.classList.add('btn-success');
                setTimeout(() => {
                    copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i>';
                    copyBtn.classList.remove('btn-success');
                    copyBtn.classList.add('btn-outline-secondary');
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy text: ', err);
            });
        }
    </script>
}
