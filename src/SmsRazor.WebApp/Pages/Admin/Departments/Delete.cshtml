@page
@model SmsRazor.WebApp.Pages.Admin.Departments.DeleteModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Department";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Delete Department</h2>
        <p class="text-muted small mb-0 mt-1">Review department details before deletion</p>
    </div>
    <a asp-page="Index" class="btn btn-light border btn-sm px-3 rounded-pill d-flex align-items-center">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="max-width: 600px;">
    <div class="card-header bg-danger bg-opacity-10 border-bottom-0 pt-4 pb-3">
        <div class="d-flex align-items-center text-danger">
            <i class="fa-solid fa-triangle-exclamation fs-4 me-3"></i>
            <div>
                <h5 class="mb-0 fw-bold">Warning</h5>
                <p class="mb-0 small">Are you sure you want to delete this department? This action is permanent and cannot be undone.</p>
            </div>
        </div>
    </div>
    <div class="card-body p-4 p-md-5 pt-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted fw-normal mb-2">English Name</dt>
            <dd class="col-sm-8 fw-medium text-dark mb-3">@Model.Department.DepartmentNameEng</dd>

            <dt class="col-sm-4 text-muted fw-normal mb-2">Vietnamese Name</dt>
            <dd class="col-sm-8 text-dark mb-3">@Model.Department.DepartmentNameVI</dd>

            <dt class="col-sm-4 text-muted fw-normal mb-2">Total Credits</dt>
            <dd class="col-sm-8 text-dark mb-3">@Model.Department.TotalCredit</dd>

            <dt class="col-sm-4 text-muted fw-normal mb-2">Status</dt>
            <dd class="col-sm-8 mb-0">
                @if (Model.Department.IsActive)
                {
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium"><i class="fa-solid fa-circle text-success small me-1" style="font-size: 0.5rem;"></i> Active</span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-medium"><i class="fa-solid fa-circle text-secondary small me-1" style="font-size: 0.5rem;"></i> Inactive</span>
                }
            </dd>
        </dl>

        <hr class="my-4 text-muted border-opacity-25" />

        <form method="post">
            <input type="hidden" asp-for="Department.DepartmentId" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-page="./Index" class="btn btn-light border px-4 rounded-pill">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 rounded-pill">Yes, Delete Department</button>
            </div>
        </form>
    </div>
</div>
