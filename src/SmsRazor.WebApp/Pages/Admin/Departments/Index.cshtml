@page
@model SmsRazor.WebApp.Pages.Admin.Departments.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Department Management</h2>
        <p class="text-muted small mb-0 mt-1">View, add, edit, and disable academic departments</p>
    </div>
    <a asp-page="Create" class="btn btn-dark btn-sm px-3 rounded-pill shadow-sm d-flex align-items-center">
        <i class="fa-solid fa-plus me-2"></i> Add Department
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                <tr>
                    <th class="ps-4 text-secondary fw-semibold small text-uppercase py-3">English Name</th>
                    <th class="text-secondary fw-semibold small text-uppercase py-3">Vietnamese Name</th>
                    <th class="text-secondary fw-semibold small text-uppercase py-3">Total Credits</th>
                    <th class="text-secondary fw-semibold small text-uppercase py-3 text-center">Status</th>
                    <th class="pe-4 text-secondary fw-semibold small text-uppercase py-3 text-end">Actions</th>
                </tr>
                </thead>
                <tbody class="border-top-0">
                @if (!Model.Departments.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fa-regular fa-folder-open fs-2 mb-3 text-light"></i>
                            <p class="mb-0">No departments found. Add a new department to get started.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var dept in Model.Departments)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@dept.DepartmentNameEng</td>
                            <td class="text-muted">@dept.DepartmentNameVI</td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@dept.TotalCredit credits</span>
                            </td>
                            <td class="text-center">
                                @if (dept.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium"><i class="fa-solid fa-circle text-success small me-1" style="font-size: 0.5rem;"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2 fw-medium"><i class="fa-solid fa-circle text-secondary small me-1" style="font-size: 0.5rem;"></i> Inactive</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-page="./Edit" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-light border text-primary rounded-pill px-3 me-1">
                                    <i class="fa-regular fa-pen-to-square me-1"></i> Edit
                                </a>
                                <a asp-page="./Delete" asp-route-id="@dept.DepartmentId" class="btn btn-sm btn-light border text-danger rounded-pill px-3">
                                    <i class="fa-regular fa-trash-can me-1"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
