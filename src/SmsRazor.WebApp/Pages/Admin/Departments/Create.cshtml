@page
@model SmsRazor.WebApp.Pages.Admin.Departments.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Department";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Create Department</h2>
        <p class="text-muted small mb-0 mt-1">Add a new department to the system</p>
    </div>
    <a asp-page="Index" class="btn btn-light border btn-sm px-3 rounded-pill d-flex align-items-center">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="max-width: 800px;">
    <div class="card-body p-4 p-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Department.DepartmentNameEng" class="form-label fw-medium text-dark">English Name <span class="text-danger">*</span></label>
                    <input asp-for="Department.DepartmentNameEng" class="form-control rounded-3" placeholder="e.g. Software Engineering" />
                    <span asp-validation-for="Department.DepartmentNameEng" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Department.DepartmentNameVI" class="form-label fw-medium text-dark">Vietnamese Name <span class="text-danger">*</span></label>
                    <input asp-for="Department.DepartmentNameVI" class="form-control rounded-3" placeholder="e.g. Kỹ thuật phần mềm" />
                    <span asp-validation-for="Department.DepartmentNameVI" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Department.TotalCredit" class="form-label fw-medium text-dark">Total Credits <span class="text-danger">*</span></label>
                    <input asp-for="Department.TotalCredit" class="form-control rounded-3" type="number" min="0" step="1" />
                    <span asp-validation-for="Department.TotalCredit" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check form-switch fs-5 pb-1">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="Department.IsActive" id="flexSwitchCheckChecked" checked>
                        <label class="form-check-label fs-6 mt-1 ms-2" for="flexSwitchCheckChecked">Active Department</label>
                    </div>
                </div>
            </div>

            <hr class="my-4 text-muted border-opacity-25" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="Index" class="btn btn-light border px-4 rounded-pill">Cancel</a>
                <button type="submit" class="btn btn-dark px-4 rounded-pill">Save Department</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
