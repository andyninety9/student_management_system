@page
@model SmsRazor.WebApp.Pages.Admin.Courses.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Courses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-courses.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-4">
    <div>
        <h2 class="mb-1 fw-bold tracking-tight text-dark">Course Catalog</h2>
        <p class="text-muted mb-0">Manage active courses and classes for the semester.</p>
    </div>
    <button class="btn btn-dark px-4 py-2 fw-semibold rounded-3">
        <i class="fa-solid fa-plus me-2"></i> Create Course
    </button>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <div class="col">
        <div class="card course-card h-100 bg-white shadow-none rounded-4 p-4 position-relative">
            <span class="badge bg-dark rounded-pill fw-normal px-3 py-2 course-badge">Active</span>
            <div class="mb-3">
                <h5 class="fw-bold text-dark mb-1">Web Development Fundamentals</h5>
                <p class="text-muted small">CS-302 &bull; Fall 2026</p>
            </div>
            <div class="mb-4 small text-muted">
                <div class="d-flex align-items-center mb-2">
                    <i class="fa-solid fa-user-tie me-3 opacity-50"></i> Dr. John Doe
                </div>
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-users me-3 opacity-50"></i> 45 / 50 Students Enrolled
                </div>
            </div>
            <div class="mt-auto pt-3 border-top d-flex">
                <button class="btn btn-sm btn-outline-dark rounded-pill px-4 me-2">Manage</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 border-0">Settings</button>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card course-card h-100 bg-white shadow-none rounded-4 p-4 position-relative">
            <span class="badge border border-dark text-dark rounded-pill fw-normal px-3 py-2 course-badge">Upcoming</span>
            <div class="mb-3">
                <h5 class="fw-bold text-dark mb-1">Advanced Cloud Computing</h5>
                <p class="text-muted small">CS-410 &bull; Spring 2027</p>
            </div>
            <div class="mb-4 small text-muted">
                <div class="d-flex align-items-center mb-2">
                    <i class="fa-solid fa-user-tie me-3 opacity-50"></i> Prof. Alice Smith
                </div>
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-users me-3 opacity-50"></i> 10 / 30 Registration Open
                </div>
            </div>
            <div class="mt-auto pt-3 border-top d-flex">
                <button class="btn btn-sm btn-outline-dark rounded-pill px-4 me-2">Manage</button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 border-0">Settings</button>
            </div>
        </div>
    </div>
</div>
