@page
@model SmsRazor.WebApp.Pages.Admin.Courses.DeleteModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Course";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-danger fw-bold">Delete Course</h2>
        <p class="text-muted small mb-0 mt-1">Are you sure you want to delete this course? This action cannot be undone.</p>
    </div>
    <a asp-page="Index" class="btn btn-light border btn-sm px-3 rounded-pill d-flex align-items-center">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-danger border-opacity-25 shadow-sm rounded-4 overflow-hidden" style="max-width: 600px;">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="text-danger mb-3">
                <i class="fa-solid fa-triangle-exclamation fa-4x opacity-75"></i>
            </div>
            <h4 class="fw-bold">@Model.Course.CourseNameEng</h4>
            <p class="text-muted mb-0">@Model.Course.CourseNameVI</p>
        </div>
        
        <div class="bg-light rounded-3 p-3 mb-4">
            <div class="row text-center border-bottom pb-2 mb-2">
                <div class="col-6 border-end">
                    <span class="text-muted d-block small text-uppercase">Credits</span>
                    <strong class="fs-5">@Model.Course.CreditNumber</strong>
                </div>
                <div class="col-6">
                    <span class="text-muted d-block small text-uppercase">Status</span>
                    @if(Model.Course.IsActive)
                    {
                        <strong class="fs-5 text-success">Active</strong>
                    }
                    else
                    {
                        <strong class="fs-5 text-secondary">Inactive</strong>
                    }
                </div>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Course.CourseId" />
            <div class="d-flex justify-content-center gap-3">
                <a asp-page="./Index" class="btn btn-light border px-4 rounded-pill">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 rounded-pill fw-medium">Confirm Delete</button>
            </div>
        </form>
    </div>
</div>
