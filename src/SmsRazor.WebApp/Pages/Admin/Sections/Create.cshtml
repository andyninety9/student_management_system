@page
@model SmsRazor.WebApp.Pages.Admin.Sections.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Class (Section)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Create New Class</h2>
        <p class="text-muted small mb-0 mt-1">Setup section details and auto-generate timetable</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm px-4 rounded-pill shadow-sm">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden max-w-4xl mx-auto">
    <div class="card-body p-4 p-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3 bg-danger bg-opacity-10 rounded-3"></div>

            <h5 class="fw-bold mb-3 border-bottom pb-2">Class Details</h5>
            
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="ScheduleGen.SectionCode" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="ScheduleGen.SectionCode" class="form-control rounded-3" placeholder="e.g. SE1616"/>
                    <span asp-validation-for="ScheduleGen.SectionCode" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ScheduleGen.Capacity" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <input asp-for="ScheduleGen.Capacity" class="form-control rounded-3" type="number" min="1" max="100"/>
                    <span asp-validation-for="ScheduleGen.Capacity" class="text-danger small"></span>
                </div>
                
                <div class="col-md-4">
                    <label asp-for="ScheduleGen.TermId" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <select asp-for="ScheduleGen.TermId" asp-items="Model.TermsList" class="form-select rounded-3">
                        <option value="">-- Select Term (Semester) --</option>
                    </select>
                    <span asp-validation-for="ScheduleGen.TermId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ScheduleGen.CourseId" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <select asp-for="ScheduleGen.CourseId" asp-items="Model.CoursesList" class="form-select rounded-3">
                        <option value="">-- Select Course --</option>
                    </select>
                    <span asp-validation-for="ScheduleGen.CourseId" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ScheduleGen.TeacherCode" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <select asp-for="ScheduleGen.TeacherCode" asp-items="Model.TeachersList" class="form-select rounded-3">
                        <option value="">-- Select Teacher --</option>
                    </select>
                    <span asp-validation-for="ScheduleGen.TeacherCode" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="fw-bold mb-3 border-bottom pb-2 mt-4 text-info">Teacher's Timetable Reference</h5>
            <p class="text-muted small mb-3">
                Select a Term and a Primary Teacher above to view their currently occupied slots.
            </p>
            <div id="calendarContainer" style="display: none;" class="mb-4">
                <div id="calendar" class="border rounded-3 shadow-sm bg-white p-3"></div>
            </div>

            <h5 class="fw-bold mb-3 border-bottom pb-2 mt-4 text-warning">Automatic Scheduling Rules</h5>
            <p class="text-muted small mb-4 bg-light p-3 rounded-3 border-start border-4 border-warning">
                <i class="fa-solid fa-calendar-check text-warning me-2"></i>
                Select the days of the week this class takes place. The system will automatically generate all timetable slots starting from the Term's start date continuing for the selected duration.
            </p>
            
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="ScheduleGen.DurationWeeks" class="form-label fw-medium text-dark"></label> <span class="text-danger">*</span>
                    <div class="input-group">
                        <input asp-for="ScheduleGen.DurationWeeks" class="form-control rounded-start-3" type="number" min="1" max="16"/>
                        <span class="input-group-text rounded-end-3 bg-light text-muted">Weeks</span>
                    </div>
                    <span asp-validation-for="ScheduleGen.DurationWeeks" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-medium text-dark">Schedule Framework</label>
                    <div class="table-responsive border rounded-3 overflow-hidden">
                        <table class="table table-sm table-borderless mb-0">
                            <thead class="bg-light border-bottom text-muted small">
                                <tr>
                                    <th class="ps-3 py-2 w-25">Select</th>
                                    <th class="py-2">Day of Week</th>
                                    <th class="pe-3 py-2 w-50">Time Slot</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.ScheduleGen.ScheduleDays.Count; i++)
                                {
                                    <tr class="border-bottom">
                                        <td class="ps-3 align-middle">
                                            <div class="form-check form-switch mb-0">
                                                <input asp-for="ScheduleGen.ScheduleDays[i].IsSelected" class="form-check-input" />
                                            </div>
                                            <input type="hidden" asp-for="ScheduleGen.ScheduleDays[i].DayOfWeek" />
                                        </td>
                                        <td class="align-middle fw-medium">
                                            @Model.ScheduleGen.ScheduleDays[i].DayOfWeek.ToString()
                                        </td>
                                        <td class="pe-3 py-2">
                                            <div class="input-group input-group-sm w-75">
                                                <span class="input-group-text bg-light">Slot</span>
                                                <select asp-for="ScheduleGen.ScheduleDays[i].Slot" class="form-select">
                                                    @for (int s = 1; s <= 6; s++)
                                                    {
                                                        <option value="@s">Slot @s</option>
                                                    }
                                                </select>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-5 pt-3 border-top">
                <a asp-page="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="fa-solid fa-magic me-2"></i> Create & Generate Timetable
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                slotMinTime: '07:00:00',
                slotMaxTime: '22:30:00',
                allDaySlot: false,
                height: 500,
                events: []
            });

            $('#ScheduleGen_TeacherCode, #ScheduleGen_TermId').on('change', function() {
                var teacherCode = $('#ScheduleGen_TeacherCode').val();
                var termId = $('#ScheduleGen_TermId').val();

                if (teacherCode && termId) {
                    $('#calendarContainer').slideDown(200, function() {
                        calendar.render();
                        
                        $.getJSON('?handler=TeacherSchedule', { teacherCode: teacherCode, termId: termId }, function(data) {
                            calendar.removeAllEvents();
                            if (data && data.length > 0) {
                                calendar.gotoDate(data[0].start);
                                $.each(data, function(index, ev) {
                                   calendar.addEvent(ev);
                                });
                            } else {
                                // Default back to today if no events
                                calendar.gotoDate(new Date());
                            }
                        }).fail(function() {
                            console.error("Failed to fetch teacher schedule.");
                        });
                    });
                } else {
                    $('#calendarContainer').slideUp(200);
                }
            });
            
            // Trigger once on load if both are already selected
            if ($('#ScheduleGen_TeacherCode').val() && $('#ScheduleGen_TermId').val()) {
                $('#ScheduleGen_TeacherCode').trigger('change');
            }
        });
    </script>
}
