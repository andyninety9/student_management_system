@page
@model SmsRazor.WebApp.Pages.Admin.Syllabus.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Syllabus";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Edit Syllabus</h2>
        <p class="text-muted small mb-0 mt-1">Modify existing syllabus details</p>
    </div>
    <a asp-page="Index" class="btn btn-light border btn-sm px-3 rounded-pill d-flex align-items-center">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="max-width: 800px;">
    <div class="card-body p-4 p-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Syllabus.SyllabusId" />
            
            <div class="row g-4">
                <div class="col-md-12">
                    <label asp-for="Syllabus.DepartmentId" class="form-label fw-medium text-dark">Department <span class="text-danger">*</span></label>
                    <select asp-for="Syllabus.DepartmentId" class="form-select rounded-3" asp-items="Model.DepartmentsList">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="Syllabus.DepartmentId" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Syllabus.SyllabusName" class="form-label fw-medium text-dark">Syllabus Name <span class="text-danger">*</span></label>
                    <input asp-for="Syllabus.SyllabusName" class="form-control rounded-3" />
                    <span asp-validation-for="Syllabus.SyllabusName" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Syllabus.EffectiveFrom" class="form-label fw-medium text-dark">Effective From <span class="text-danger">*</span></label>
                    <input asp-for="Syllabus.EffectiveFrom" class="form-control rounded-3" type="date" />
                    <span asp-validation-for="Syllabus.EffectiveFrom" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Syllabus.EffectiveTo" class="form-label fw-medium text-dark">Effective To (Optional)</label>
                    <input asp-for="Syllabus.EffectiveTo" class="form-control rounded-3" type="date" />
                    <span asp-validation-for="Syllabus.EffectiveTo" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Syllabus.Description" class="form-label fw-medium text-dark">Description</label>
                    <textarea asp-for="Syllabus.Description" class="form-control rounded-3" rows="3" placeholder="Enter syllabus details..."></textarea>
                    <span asp-validation-for="Syllabus.Description" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Syllabus.CourseIds" class="form-label fw-medium text-dark">Courses</label>
                    <select asp-for="Syllabus.CourseIds" class="form-select rounded-3 select2-multi" asp-items="Model.CoursesList" multiple="multiple" style="width: 100%;">
                    </select>
                    <span asp-validation-for="Syllabus.CourseIds" class="text-danger small"></span>
                </div>

                <div class="col-md-12 mt-4 text-end">
                    <div class="form-check form-switch fs-5 pb-1">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="Syllabus.IsActive" id="flexSwitchCheckChecked">
                        <label class="form-check-label fs-6 mt-1 ms-2" for="flexSwitchCheckChecked">Active Syllabus</label>
                    </div>
                </div>
            </div>

            <hr class="my-4 text-muted border-opacity-25" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="Index" class="btn btn-light border px-4 rounded-pill">Cancel</a>
                <button type="submit" class="btn btn-dark px-4 rounded-pill">Update Syllabus</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <!-- Select2 Configuration -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- Select2 Bootstrap 5 Theme -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.select2-multi').select2({
                placeholder: "Search and select courses to include...",
                allowClear: true,
                theme: "bootstrap-5",
                width: '100%'
            });
        });
    </script>
}
