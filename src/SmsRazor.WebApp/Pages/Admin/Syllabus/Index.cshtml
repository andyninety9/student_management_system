@page
@model SmsRazor.WebApp.Pages.Admin.Syllabus.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Syllabi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-0 text-gray-800 fw-bold">Syllabus <span class="fw-light">Management</span></h2>
        <p class="text-muted small mb-0 mt-1">Manage academic syllabi for all departments</p>
    </div>
    <a asp-page="./Create" class="btn btn-dark btn-sm px-3 rounded-pill d-flex align-items-center">
        <i class="fa-solid fa-plus me-2"></i> Create Syllabus
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
        <h5 class="card-title fw-bold mb-0">All Syllabi</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 minimal-table">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 text-uppercase text-secondary small fw-semibold">Syllabus Name</th>
                        <th class="text-uppercase text-secondary small fw-semibold">Department</th>
                        <th class="text-uppercase text-secondary small fw-semibold">Effective Period</th>
                        <th class="text-uppercase text-secondary small fw-semibold text-center">Status</th>
                        <th class="pe-4 text-uppercase text-secondary small fw-semibold text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Syllabi.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-folder-open fa-2x mb-3 d-block text-black-50"></i>
                                No syllabi found. Click "Create Syllabus" to add one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var syllabus in Model.Syllabi)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    @syllabus.SyllabusName
                                </td>
                                <td>@syllabus.DepartmentName</td>
                                <td class="text-muted small">
                                    @syllabus.EffectiveFrom.ToString("MMM yyyy") 
                                    - 
                                    @(syllabus.EffectiveTo.HasValue ? syllabus.EffectiveTo.Value.ToString("MMM yyyy") : "Present")
                                </td>
                                <td class="text-center">
                                    @if (syllabus.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-medium"><i class="fa-solid fa-circle fa-2xs me-1"></i> @syllabus.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-1 fw-medium"><i class="fa-solid fa-circle fa-2xs me-1"></i> Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="btn-group btn-group-sm rounded-pill" role="group">
                                        <a asp-page="./Edit" asp-route-id="@syllabus.SyllabusId" class="btn btn-light border btn-action"><i class="fa-regular fa-pen-to-square"></i></a>
                                        <a asp-page="./Delete" asp-route-id="@syllabus.SyllabusId" class="btn btn-light border text-danger btn-action"><i class="fa-regular fa-trash-can"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
